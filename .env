# Required for the default model in this template.
GOOGLE_API_KEY=your-google-api-key-here

# Optional: override the default model string used by src/simple_agent/graph.py.
SIMPLE_AGENT_MODEL=google_genai:gemini-2.5-flash
GITHUB_TOKEN=your-github-token-here

# Disable LangSmith tracing (no API key required)
LANGSMITH_API_KEY=your-langsmith-api-key-here
